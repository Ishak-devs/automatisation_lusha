# Clé API Lusha (API Hub > Manage API Keys sur app.lusha.com)
LUSHA_API_KEY=

# Port du serveur
PORT=3000

# Planning de sync automatique (format cron). Défaut: tous les jours à 6h
CRON_SCHEDULE=0 6 * * *

# Filtres de recherche contacts (JSON, format Lusha Prospecting API)
CONTACT_FILTERS_JSON={"jobTitles":["CEO","CTO","VP Sales"],"seniority":["c_suite","vp"]}

# Filtres de recherche entreprises (JSON)
COMPANY_FILTERS_JSON={"locations":["France"],"sizes":["51-200","201-500"]}
